# Скопируйте в .env и заполните.

# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Облачный пароль Telegram (2FA) для входа по QR. Необязательно: если не задан, скрипт спросит
# в терминале. Нужен для запуска без интерактивного терминала (Docker, сервис).
# TELEGRAM_2FA_PASSWORD=

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID тех, кому разрешено пользоваться ботом (через запятую).
# Узнать свой ID: напишите боту любое сообщение — он ответит "Нет доступа. Ваш ID: ..."
ALLOWED_USER_IDS=

# Ключ того провайдера, который выбран в config.toml (остальные можно не заполнять)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
